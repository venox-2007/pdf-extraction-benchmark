# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Ruff cache
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment files
.env

# Output/runtime artifacts
/outputs/**
!/outputs/
!/outputs/.gitkeep

# Keep all benchmark results (summaries + raw per-document artifacts) —
# these are cited as sources throughout docs/comparison_matrix.md,
# docs/cost_analysis.md, docs/benchmark_findings.md, and
# docs/final_benchmark_report.md, and are not cheaply reproducible
# (the final_60 corpus run alone takes ~20 minutes of compute).
!/outputs/benchmark_results/
!/outputs/benchmark_results/**

# Keep empty output directories
!/outputs/benchmarks/
!/outputs/benchmarks/.gitkeep
!/outputs/charts/
!/outputs/charts/.gitkeep
!/outputs/json/
!/outputs/json/.gitkeep
!/outputs/logs/
!/outputs/logs/.gitkeep
!/outputs/markdown/
!/outputs/markdown/.gitkeep

# Processed/derived data
data/processed/*
!data/processed/.gitkeep

# Raw PAN dataset (downloaded from Roboflow, ~1400 images) — too large to
# track in full. Keep the manifest and metadata needed to reproduce the
# 20-image qualitative sample; re-download train/valid images if needed.
data/PAN.v2i.yolov8/train/*
data/PAN.v2i.yolov8/valid/*

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/*.log
.idea/
