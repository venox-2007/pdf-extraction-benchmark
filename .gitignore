# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Build artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Ruff cache
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment files
.env

# Output/runtime artifacts
/outputs/**
!/outputs/
!/outputs/.gitkeep

# Keep curated benchmark summaries
!/outputs/benchmark_results/
!/outputs/benchmark_results/benchmark_observations.md
!/outputs/benchmark_results/benchmark_summary.csv
!/outputs/benchmark_results/benchmark_summary.json
# Keep PAN qualitative benchmark outputs (text + annotated images)
!/outputs/benchmark_results/pan_card_qualitative/
!/outputs/benchmark_results/pan_card_qualitative/**

# Keep empty output directories
!/outputs/benchmarks/
!/outputs/benchmarks/.gitkeep
!/outputs/charts/
!/outputs/charts/.gitkeep
!/outputs/json/
!/outputs/json/.gitkeep
!/outputs/logs/
!/outputs/logs/.gitkeep
!/outputs/markdown/
!/outputs/markdown/.gitkeep

# Processed/derived data
data/processed/*
!data/processed/.gitkeep

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/*.log
.idea/
